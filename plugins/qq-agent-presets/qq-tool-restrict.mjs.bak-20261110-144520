 * 锛?026-11-01 瀹炴祴锛氶潤鎬佸悕鍗?82 涓悕瀛楅噷鍙湁 4 涓瓨鍦ㄤ簬褰撴椂鐨勫叏灞€灞傦紝78 涓潤榛?
 *  澶辨晥 鈥斺€?缇ら噷鍥犳涓€鐩磋兘鐪嬪埌 bili_ 銆乬ate_ 銆乵emory_ 銆乧ron_ 杩欎簺鍓嶇紑鐨勫叏灞€宸ュ叿銆傦級
 * 杩斿洖 null 琛ㄧず鎺㈡祴澶辫触锛岃皟鐢ㄦ柟閫€鍥為潤鎬佸悕鍗曘€?
 */
function probeGlobalNames(ctx) {
  try {
    ctx.tools.restrict({ deny: ['__qq_probe_unknown_tool__'] })
    return []
  } catch (error) {
    const msg = String(error?.message ?? error)
    const marker = 'known global tools:'
    const at = msg.indexOf(marker)
    if (at < 0) return null
    const names = msg
      .slice(at + marker.length)
      .split(',')
      .map((s) => s.trim())
      .filter((s) => /^[A-Za-z0-9_.:-]+$/.test(s))
    return names.length ? names : null
  }
}

export function apply(ctx) {
  const allowedName = (name) => SAFE_EXACT.has(name) || SAFE_PREFIXES.some((p) => name.startsWith(p))

  // 1) 鎶婁笉璇ュ嚭鐜板湪 QQ 浼氳瘽閲岀殑鍏ㄥ眬宸ュ叿浠?schema 闅愯棌銆?
  //
  // 鍔ㄦ€佹帰娴嬬湡瀹炲叏灞€宸ュ叿娓呭崟 鈫?婊ゆ帀鐧藉悕鍗?鈫?鏁存壒 restrict銆?
  // 鏁存壒涓€娆¤皟鐢紝鏄洜涓?restrict 鐨勬湭鐭ュ悕鏍￠獙鏄師瀛愮殑锛氬悕鍗曢噷鍙鏈変竴涓亣鍚嶅氨鏁存壒
  // 澶辫触锛岄€愪釜璋冪敤鍙嶈€屼細鎶?鍚嶅崟璺熶笉涓婃彃浠?鍙樻垚闈欓粯澶辨晥锛堝巻鍙叉晠闅滄牴鍥狅級銆?
  //
  // 涓轰粈涔?*涓?*绗竴娆℃垚鍔熷氨鏀跺伐锛?026-11-01 瀹炴祴鏁欒锛夛細鎻掍欢鏄垎鎵规敞鍐岀殑锛岀涓€娆℃帰娴?
  // 鍙湅鍒?18 涓叏灞€宸ュ叿锛屼箣鍚?bili_/gate_/cron_ 绛夋墠闄嗙画杩涘叏灞€灞傦紱鏃╂敹宸ヤ細婕忔帀瀹冧滑銆?
  // 鎵€浠ユ寜鍥哄畾鏃堕棿琛ㄥ鎺㈡祴鍑犺疆锛屾瘡杞妸**鏂板嚭鐜?*鐨勫悕瀛楄ˉ杩涘幓锛坮estrict 鍙噸澶嶈皟鐢ㄣ€佺疮鍔狅級銆?
  const PASSES = [1200, 4500, 9500, 16000]
  const deniedSoFar = new Set()
  let passNo = 0
  const run = () => {
    passNo += 1
    const probed = probeGlobalNames(ctx)
    const dynamicDeny = probed ? probed.filter((n) => !allowedName(n)) : null
    const staticDeny = KNOWN_DANGEROUS_GLOBAL_TOOLS.filter((n) => !allowedName(n))
    // 鎺㈡祴鎴愬姛灏辩敤鐪熸竻鍗曪紙闈欐€佸悕鍗曢噷蹇呯劧鏈変竴閮ㄥ垎鍚嶅瓧鍦ㄥ綋鍓?composition 閲屼笉瀛樺湪锛?
    // 娣疯繘鍘讳細璁╂暣鎵瑰師瀛愭牎楠屽け璐ワ級锛屾帰娴嬪け璐ユ墠閫€鍥為潤鎬佸悕鍗曘€?
    const candidates = dynamicDeny && dynamicDeny.length ? dynamicDeny : staticDeny
    const fresh = candidates.filter((n) => !deniedSoFar.has(n))
    try {
      if (fresh.length) ctx.tools.restrict({ deny: fresh })
      for (const n of fresh) deniedSoFar.add(n)
      const src = dynamicDeny && dynamicDeny.length ? `鍔ㄦ€?{(probed || []).length}` : '闈欐€?
      if (passNo === PASSES.length || fresh.length) {
        console.error(`[qq-tool-restrict] 绗?${passNo} 杞細鏈疆琛ユ尅 ${fresh.length} 涓紝绱 ${deniedSoFar.size} 涓紙${src}锛塦)
        writeDiagnostics([`${new Date().toISOString()} pass=${passNo} fresh=${fresh.length} total=${deniedSoFar.size} source=${src}`])
      }
    } catch (error) {
      const why = String(error?.message ?? error)
      console.error(`[qq-tool-restrict] 绗?${passNo} 杞?restrict 澶辫触锛?{why.slice(0, 200)}`)
      writeDiagnostics([`${new Date().toISOString()} pass=${passNo} restrict 澶辫触: ${why.slice(0, 400)}`])
      // 鏁存壒澶辫触灏遍€€鍥為€愪釜锛岃兘鎸′竴涓槸涓€涓紙鎵ц鏈?guard 浠嶇劧鏄‖杈圭晫锛?
      let ok = 0
      for (const name of fresh) {
        try { ctx.tools.restrict({ deny: [name] }); deniedSoFar.add(name); ok += 1 } catch {}
      }
      if (ok) writeDiagnostics([`${new Date().toISOString()} pass=${passNo} 閫愪釜鍏滃簳 ok=${ok}/${fresh.length}`])
    }
    const next = PASSES[passNo]
    if (next !== undefined) {
      const t = setTimeout(run, next - PASSES[passNo - 1])
      t?.unref?.()
    }
  }
  run()

  // 2) 鎵ц鏈熺櫧鍚嶅崟锛氫换浣曚笉鍦ㄥ厑璁歌寖鍥村唴鐨勫伐鍏疯皟鐢ㄩ兘浼氳鎷掔粷銆?
  ctx.tools.guard((exec) => {
    const name = exec?.name
    if (typeof name !== 'string' || name.length === 0) return '宸ュ叿鍚嶆棤鏁堬紝宸叉嫆缁?
    if (SAFE_EXACT.has(name)) return
    if (SAFE_PREFIXES.some((prefix) => name.startsWith(prefix))) return
    return `宸ュ叿 "${name}" 涓嶅湪 QQ 妗ユ帴鐧藉悕鍗曞唴锛屽凡鎷掔粷锛堜粎鍏佽 QQ MCP 宸ュ叿涓庢棤瀹虫ā鍨嬩晶宸ュ叿锛塦
  })
}
