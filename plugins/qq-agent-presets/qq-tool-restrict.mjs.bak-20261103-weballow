// 供 test-preset-local-tools.mjs 导入并与 DSH 真实工具名对账，避免两份名单漂移。
export const RESTRICTED_TOOL_NAMES = Object.freeze([...KNOWN_DANGEROUS_GLOBAL_TOOLS])

// 执行期白名单：不在这些范围内的工具一律拒绝。
// 前缀覆盖 DSH MCP client 暴露的命名空间工具。
const SAFE_PREFIXES = [
  'mcp__snowluma__',
  'mcp__snowluma-host__',
  'mcp__web-search-safe__',
]

// 无害模型侧工具：ask_user_question 用于把问题转给管理员/用户，
// todo_write 仅维护任务列表。若后续 preset 不再挂载这些工具，保留无害。
// affinity 是本机自写的好感度计数器（只读写一个 JSON，无执行能力），群里要用，
// 所以放行；如果要收紧就把它从这里删掉。
const SAFE_EXACT = new Set([
  'ask_user_question',
  'todo_write',
  'affinity',
  'cf_fetch',
])

// ── 诊断落盘：restrict 失败时到底为什么 ────────────────────────────────────
//
// 为什么必须落盘（2026-10-18 实测）：重启之后新建的 QQ 会话 schema 里，
// `dev_*` **仍然是 18 个**——说明 `ctx.tools.restrict({deny})` 根本没生效，
// 而失败被下面的 per-name try/catch 吞掉了。DSH 的 stderr 不落日志文件（只有启动失败
// 才会写 ~/.dsh/logs），所以「为什么失败」在现网完全不可观测。
//
// 这里把失败原因写到 <repo>/state/tool-restrict.log（有界、只写最近 20 行），
// 并把失败的名字在 3 秒后重试一次：如果只是「注入器比 preset 晚注册」的时序问题，
// 重试就能把工具真正藏掉；如果重试也失败，日志里会留下 DSH 的原始报错，
// 下次排查不用再猜。
const DIAG_FILE = (() => {
  // 测试可用 QQ_TOOL_RESTRICT_LOG 改到临时文件，避免污染真实 state/
  if (process.env.QQ_TOOL_RESTRICT_LOG) return path.resolve(process.env.QQ_TOOL_RESTRICT_LOG)
  try {
    // 本文件位于 <repo>/plugins/qq-agent-presets/，往上两层就是仓库根
    return fileURLToPath(new URL('../../state/tool-restrict.log', import.meta.url))
  } catch { return '' }
})()

function writeDiagnostics(lines) {
  if (!DIAG_FILE || !lines.length) return
  // 单行截断：DSH 的报错里会把**整份** known global tools 清单拼进去（实测单行 2KB+），
  // 不截就等于把日志变成噪声。保留开头足够定位的信息即可。
  const trim = (line) => (line.length > 240 ? `${line.slice(0, 240)}…` : line)
  try {
    const previous = (() => {
      try { return fs.readFileSync(DIAG_FILE, 'utf8').split('\n').filter(Boolean) } catch { return [] }
    })()
    // 有界：只保留最近 20 条（每次 agent 创建都会写一轮，别让文件无限长）
    const next = [...previous, ...lines.map(trim)].slice(-20)
    fs.mkdirSync(path.dirname(DIAG_FILE), { recursive: true })
    fs.writeFileSync(DIAG_FILE, next.join('\n') + '\n', 'utf8')
  } catch {}
}

/**
 * 探测 DSH 当前真实的「已知全局工具」清单。
 *
 * 为什么探测而不是硬编码：restrict() 对未知名是整批原子校验的，而它的报错里会把
 * **完整的** known global tools 列表拼出来。用一个假名触发一次就能读到真清单，
 * 于是"该挡哪些"不再取决于手写名单能不能跟上插件安装。
 * （2026-11-01 实测：静态名单 82 个名字里只有 4 个存在于当时的全局层，78 个静默
 *  失效 —— 群里因此一直能看到 bili_ 、gate_ 、memory_ 、cron_ 这些前缀的全局工具。）
 * 返回 null 表示探测失败，调用方退回静态名单。
 */
function probeGlobalNames(ctx) {
  try {
    ctx.tools.restrict({ deny: ['__qq_probe_unknown_tool__'] })
    return []
  } catch (error) {
    const msg = String(error?.message ?? error)
    const marker = 'known global tools:'
    const at = msg.indexOf(marker)
    if (at < 0) return null
    const names = msg
      .slice(at + marker.length)
      .split(',')
      .map((s) => s.trim())
      .filter((s) => /^[A-Za-z0-9_.:-]+$/.test(s))
    return names.length ? names : null
  }
}

export function apply(ctx) {
  const allowedName = (name) => SAFE_EXACT.has(name) || SAFE_PREFIXES.some((p) => name.startsWith(p))

  // 1) 把不该出现在 QQ 会话里的全局工具从 schema 隐藏。
  //
  // 动态探测真实全局工具清单 → 滤掉白名单 → 整批 restrict。
  // 整批一次调用，是因为 restrict 的未知名校验是原子的：名单里只要有一个假名就整批
  // 失败，逐个调用反而会把"名单跟不上插件"变成静默失效（历史故障根因）。
  //
  // 为什么**不**第一次成功就收工（2026-11-01 实测教训）：插件是分批注册的，第一次探测
  // 只看到 18 个全局工具，之后 bili_/gate_/cron_ 等才陆续进全局层；早收工会漏掉它们。
  // 所以按固定时间表多探测几轮，每轮把**新出现**的名字补进去（restrict 可重复调用、累加）。
  const PASSES = [1200, 4500, 9500, 16000]
  const deniedSoFar = new Set()
  let passNo = 0
  const run = () => {
    passNo += 1
    const probed = probeGlobalNames(ctx)
    const dynamicDeny = probed ? probed.filter((n) => !allowedName(n)) : null
    const staticDeny = KNOWN_DANGEROUS_GLOBAL_TOOLS.filter((n) => !allowedName(n))
    // 探测成功就用真清单（静态名单里必然有一部分名字在当前 composition 里不存在，
    // 混进去会让整批原子校验失败），探测失败才退回静态名单。
    const candidates = dynamicDeny && dynamicDeny.length ? dynamicDeny : staticDeny
    const fresh = candidates.filter((n) => !deniedSoFar.has(n))
    try {
      if (fresh.length) ctx.tools.restrict({ deny: fresh })
      for (const n of fresh) deniedSoFar.add(n)
      const src = dynamicDeny && dynamicDeny.length ? `动态${(probed || []).length}` : '静态'
      if (passNo === PASSES.length || fresh.length) {
        console.error(`[qq-tool-restrict] 第 ${passNo} 轮：本轮补挡 ${fresh.length} 个，累计 ${deniedSoFar.size} 个（${src}）`)
        writeDiagnostics([`${new Date().toISOString()} pass=${passNo} fresh=${fresh.length} total=${deniedSoFar.size} source=${src}`])
      }
    } catch (error) {
      const why = String(error?.message ?? error)
      console.error(`[qq-tool-restrict] 第 ${passNo} 轮 restrict 失败：${why.slice(0, 200)}`)
      writeDiagnostics([`${new Date().toISOString()} pass=${passNo} restrict 失败: ${why.slice(0, 400)}`])
      // 整批失败就退回逐个，能挡一个是一个（执行期 guard 仍然是硬边界）
      let ok = 0
      for (const name of fresh) {
        try { ctx.tools.restrict({ deny: [name] }); deniedSoFar.add(name); ok += 1 } catch {}
      }
      if (ok) writeDiagnostics([`${new Date().toISOString()} pass=${passNo} 逐个兜底 ok=${ok}/${fresh.length}`])
    }
    const next = PASSES[passNo]
    if (next !== undefined) {
      const t = setTimeout(run, next - PASSES[passNo - 1])
      t?.unref?.()
    }
  }
  run()

  // 2) 执行期白名单：任何不在允许范围内的工具调用都会被拒绝。
  ctx.tools.guard((exec) => {
    const name = exec?.name
    if (typeof name !== 'string' || name.length === 0) return '工具名无效，已拒绝'
    if (SAFE_EXACT.has(name)) return
    if (SAFE_PREFIXES.some((prefix) => name.startsWith(prefix))) return
    return `工具 "${name}" 不在 QQ 桥接白名单内，已拒绝（仅允许 QQ MCP 工具与无害模型侧工具）`
  })
}
